diff --git a/CMakeLists.txt b/CMakeLists.txt
index 37760a3..3ee9041 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -66,8 +66,22 @@ include_directories(${ZLIB_INCLUDE_DIRS})
 find_package(LibArchive REQUIRED)
 include_directories(${LibArchive_INCLUDE_DIR})
 
-find_package(FFMPEG COMPONENTS AVCODEC AVFORMAT AVUTIL SWSCALE SWRESAMPLE REQUIRED)
-include_directories(${FFMPEG_INCLUDE_DIRS})
+# FFMPEG provides in-game video decoding. On iOS the vcpkg build of ffmpeg
+# (and its libiconv dependency) fails to compile against the very new Xcode/iOS
+# SDKs, so we make it optional and fall back to a stub VideoManager (no video).
+# See README-iOS.md "ffmpeg fallback". When vcpkg does not provide ffmpeg the
+# find_package below silently disables it and we build the stub.
+option(USE_FFMPEG "Build with ffmpeg in-game video support" ON)
+if (USE_FFMPEG)
+    find_package(FFMPEG COMPONENTS AVCODEC AVFORMAT AVUTIL SWSCALE SWRESAMPLE)
+    if (FFMPEG_FOUND)
+        include_directories(${FFMPEG_INCLUDE_DIRS})
+        add_compile_definitions(USE_FFMPEG)
+    else ()
+        message(WARNING "FFMPEG not found; building without in-game video (stub VideoManager)")
+        set(USE_FFMPEG OFF)
+    endif ()
+endif ()
 
 #add_compile_options(-fsanitize=address -g)
 #add_link_options(-fsanitize=address)
